# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/habit_tracker?sslmode=disable

# JWT signing secret — MUST be at least 32 characters. Change this in production!
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Application environment: development | production
APP_ENV=development

# HTTP port (default: 8080)
PORT=8080
